# Copy to .env.local (ignored by git) and fill in. Keys stay server-side.
SONIOX_API_KEY=
OPENROUTER_API_KEY=
# OpenRouter model id for suggestions; Haiku 4.5 for latency.
COACH_MODEL=anthropic/claude-haiku-4.5
# Language the wearer practises (suggestions come in it) and the one they slip into.
PRACTICE_LANGUAGE=fr
FALLBACK_LANGUAGE=en
