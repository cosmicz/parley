# Copy to .env.local (ignored by git) and fill in. Keys stay server-side.
SONIOX_API_KEY=
OPENROUTER_API_KEY=
# Used when OPENROUTER_API_KEY is empty: suggestions and clip transcription
# go to OpenAI directly.
OPENAI_API_KEY=
# OpenAI model for suggestions; COACH_MODEL is used instead if it holds a
# bare OpenAI id (no "/").
OPENAI_COACH_MODEL=gpt-4.1-mini
# Experimental: 1 streams speech to OpenAI realtime transcription
# (gpt-live-transcribe) instead of clips. Needs OPENAI_API_KEY; Soniox wins.
REALTIME_STT=
# OpenRouter model id for suggestions; Haiku 4.5 for latency.
COACH_MODEL=anthropic/claude-haiku-4.5
# Model for clip transcription (POST /api/transcribe), used when there is no
# SONIOX_API_KEY. Defaults: openai/gpt-4o-transcribe on OpenRouter,
# gpt-4o-transcribe on OpenAI (an OpenRouter slug is ignored there).
TRANSCRIBE_MODEL=
# Language the wearer practises (suggestions come in it) and the one they slip into.
PRACTICE_LANGUAGE=fr
FALLBACK_LANGUAGE=en
